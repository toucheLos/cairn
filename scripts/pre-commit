#!/bin/sh
# cairn pre-commit hook: refuse to commit unredacted fixture material.
#
# It scans the *staged* blob rather than the working tree. A file can be staged
# clean and then modified, and it is the staged bytes that would be committed.
#
# Install with `make install-hooks`. It is a backstop, not the process: fixtures
# are redacted by hand (CLAUDE.md §3).

set -e

# 1. Nothing from the private corpus may ever be staged.
#
# .gitignore covers the ordinary case; this covers `git add -f`. The material
# there is a real site's log output, and a push is not reversible — so this
# refuses the whole commit rather than quietly skipping the file.
staged_corpus=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^corpus/' || true)
if [ -n "$staged_corpus" ]; then
	cat >&2 <<MSG

pre-commit: refusing to commit files from the private corpus.

$staged_corpus

These are observed incidents. CLAUDE.md §3: raw output, redacted output, and the
event streams derived from them never reach this repository. Only the taxonomy
built from them and the accuracy measured over them are published.

Run "git restore --staged corpus/" and commit the rest.
MSG
	exit 1
fi

# 2. No fixture may declare itself observed, wherever it sits. Checked by content
#    rather than path: a real incident placed outside corpus/ is exactly the case
#    a path rule misses.
for meta in $(git diff --cached --name-only --diff-filter=ACM | grep -E 'meta\.yaml$' || true); do
	if git show ":$meta" | grep -qE '^synthetic:[[:space:]]*false'; then
		cat >&2 <<MSG

pre-commit: $meta declares synthetic: false.

An observed fixture cannot be committed (CLAUDE.md §3). Move it under corpus/,
which is gitignored and refused by this hook.
MSG
		exit 1
	fi
done

# Both corpora: site/testdata holds captured producer output for the discovery
# probes, and can leak a hostname or a storage address exactly as fixtures/ can.
files=$(git diff --cached --name-only --diff-filter=ACM -- 'fixtures/*' 'site/testdata/*' \
	| grep -v '\.go$' | grep -v '\.redaction-ok$' || true)
[ -z "$files" ] && exit 0

if ! command -v go >/dev/null 2>&1; then
	echo "pre-commit: go not found; cannot scan staged fixtures." >&2
	echo "Install Go or commit with --no-verify only if you have checked these by hand." >&2
	exit 1
fi

status=0
for f in $files; do
	if ! git show ":$f" | go run ./redact/scan/cmd/scan-fixtures -name "$f"; then
		status=1
	fi
done

if [ "$status" -ne 0 ]; then
	cat >&2 <<'MSG'

pre-commit: the staged fixtures contain material that looks unredacted.

Redact by hand (CLAUDE.md §3). If a match is genuinely safe, record it in that
directory's input/.redaction-ok with a reason — do not silence the rule, and do
not use --no-verify to get past this.
MSG
fi
exit $status
